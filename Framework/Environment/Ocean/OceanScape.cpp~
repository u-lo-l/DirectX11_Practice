#include "framework.h"
#include "OceanScape.h"

constexpr UINT CascadeSize = 3;

OceanScape::OceanScape(OceanScapeDesc InDesc)
: Info(std::move(InDesc)), Tf(new Transform())
{
	Tf->SetWorldPosition({0, Info.SeaLevel, 0});
	Info.Dimension.Y = static_cast<float>(Info.FFTData.Size) / 20.f;
#pragma region Compute
	SetupCSShaders();
	SetupCSResources();
#pragma endregion Compute

#pragma region Render
	SetupCells(Info);
#pragma endregion Render
}

OceanScape::~OceanScape()
{
#pragma region Compute
	// Resources
	SAFE_DELETE(GaussianRandomTexture2D);
	SAFE_DELETE(InitialSpectrumTexture2D);
	SAFE_DELETE(SpectrumTexture2D);
	SAFE_DELETE(IFFT_Result_Transposed);
	SAFE_DELETE(IFFT_Result);
	SAFE_DELETE(CB_PhillipsInit);
	SAFE_DELETE(CB_PhillipsUpdate);
		
	// SAFE_DELETE(PerlinNoise);
	// Shaders
	SAFE_DELETE(CS_SpectrumInitializer);
	SAFE_DELETE(CS_SpectrumUpdater);
	SAFE_DELETE(CS_RowPassIFFT);
	SAFE_DELETE(CS_TransposeTexArray);
	SAFE_DELETE(CS_ColPassIFFT)
	SAFE_DELETE(CS_NormalMapGenerator)
#pragma endregion Compute

#pragma region Render
	SAFE_DELETE(Mat);
#pragma endregion Render
}

void OceanScape::ReGeneratePopup()
{
	if (ImGui::BeginPopup("New Wave"))
	{
		ImGui::Text("CreateInitialSpectrum?");
		ImGui::InputFloat2("Wind", Info.FFTData.Wind, "%.3f");
		if (ImGui::Button("OK"))
		{
			CreateInitialSpectrum();  // 호출
			ImGui::CloseCurrentPopup(); // 팝업 닫기
		}
		if (ImGui::Button("Cancel"))
			ImGui::CloseCurrentPopup(); // 팝업 닫기
		ImGui::EndPopup();
	}
}

void OceanScape::ShaderRecompilePopup()
{
	if (ImGui::BeginPopup("OceanScape Shaders"))
	{
		ImGui::BeginChild("Render Shader", {500.f, 50}, ImGuiChildFlags_Borders);
		ImGui::Text("Render Shader");
		if (ImGui::Button("Recompile"))
			Mat->GetRenderingShader()->Recompile();
		ImGui::EndChild();
		ImGui::BeginChild("ComputeShaders", {500.f, 250.f}, ImGuiChildFlags_Borders);
		static int current_item = -1;
		const char* items[] = {
			"SpectrumInitializer",
			"SpectrumUpdater",
			"TransposeTexArray",
			"RowPassIFFT",
			"ColPassIFFT",
			"SimulateFoam",
			"NormalMapGenerator",
			"TransposeTexSelf"
		};
		if (ImGui::BeginListBox("Compute Shaders"))
		{
			for (int i = 0; i < IM_ARRAYSIZE(items); i++)
			{
				const bool is_selected = (current_item == i);
				if (ImGui::Selectable(items[i], is_selected))
					current_item = i;
				if (is_selected)
					ImGui::SetItemDefaultFocus();
			}
			ImGui::EndListBox();
		}
		if (current_item != -1)
		{
			if (ImGui::Button("Recompile"))
				(*ComputeShaders[items[current_item]])->Recompile();
		}
		ImGui::EndChild();
		if (ImGui::Button("Cancel"))
			ImGui::CloseCurrentPopup(); // 팝업 닫기
		ImGui::EndPopup();
	}
}

void OceanScape::Tick()
{
#pragma region Compute
	// PhilipsUpdateData.RunningTime = (sdt::SystemTimer::Get()->GetRunningTime() - PhilipsUpdateData.InitTime);
	ImGui::Begin("OceanScape");
	if (ImGui::Button("Shaders") == true)
	{
		ImGui::OpenPopup("OceanScape Shaders");
	}
	ShaderRecompilePopup();
	if (ImGui::Button("ReGenerate Wave") == true)
	{
		ImGui::OpenPopup("New Wave");
	}
	ReGeneratePopup();
	ImGui::Text(
		"Wind       : %.2f %.2f\n"
		"Ocean Size : %.2f %.2f\n"
		"FFTSize    : %d\n"
		"Cell Size  : %d\n"
		"Grid Size  : %.2f ~ %.2f",
		Info.FFTData.Wind.X , Info.FFTData.Wind.Y,
		Info.Dimension.X, Info.Dimension.X,
		Info.FFTData.Size,
		Info.CellSize,
		static_cast<float>(Info.GridSize) / 64.f,
		static_cast<float>(Info.GridSize)
	);
	
	ImGui::SliderFloat("Time Scaler", &this->TimeScaler, 0.f, 5.f, "%.1f");
	ImGui::SliderFloat("OceanHeightScaler", &Info.Dimension.Y, 0.f, static_cast<float>(Info.FFTData.Size), "%.3f");
	CellInstance->SetHeightScaler(Info.Dimension.Y);
	
	// Update Spectrum
	UpdateSpectrum();
	IFFT();
	UpdateFoam();
	UpdateNormalMap();

#pragma endregion Compute

#pragma region Render
	Mat->Tick();
#pragma endregion Render
	ImGui::End();
}

void OceanScape::SetupCSShaders()
{
	constexpr UINT TextureThreadGroupSize = 32;
	const UINT TextureDispatchSize = Info.FFTData.Size / TextureThreadGroupSize;
	const string TextureThreadGroupSizeStr = std::to_string(TextureThreadGroupSize);
	vector<pair<string, string>> TextureShaderMacros = {
		{"THREAD_X", TextureThreadGroupSizeStr.c_str()},
		{"THREAD_Y", TextureThreadGroupSizeStr.c_str()},
	};
	ComputeShaderDesc TextureDesc {
		"TODO",
		L"TODO",
		TextureShaderMacros,
		L"CSMain",
		TextureThreadGroupSize,
		TextureThreadGroupSize,
		1,
		TextureDispatchSize,
		TextureDispatchSize,
		CascadeSize,
		{},
		true
	};
	
	const string FFTSizeStr = to_string(Info.FFTData.Size);
	const UINT FFTDispatchSize = Info.FFTData.Size;
	const string FFTThreadGroupLengthStr = to_string(Info.FFTData.Size / 2);
	const string FFTLogN = to_string(log2(Info.FFTData.Size));
	const vector<pair<string, string>> FFTShaderMacros = {
		{"FFT_SIZE", FFTSizeStr.c_str()},
		{"THREAD_GROUP_SIZE", FFTThreadGroupLengthStr.c_str()},
		{"LOG_N", FFTLogN.c_str()},
	};
	ComputeShaderDesc FFTDesc {
		"TODO",
		L"TODO",
		FFTShaderMacros,
		L"CSMain",
		Info.FFTData.Size / 2,1,1,
		FFTDispatchSize,1,3 * CascadeSize,
		{},
		true
	};
	
	{
		TextureDesc.ShaderName = "WaveSpectrum";
		TextureDesc.ShaderFileName = L"Ocean/Compute/PhilipsSpectrum.Initialize.hlsl";
		CS_SpectrumInitializer = new ComputeShader(TextureDesc);
	}
	{
		TextureDesc.ShaderName = "Update Spectrum";
		TextureDesc.ShaderFileName = L"Ocean/Compute/PhilipsSpectrum.Update.hlsl";
		CS_SpectrumUpdater = new ComputeShader(TextureDesc);
	}
	{
		TextureDesc.ShaderName = "Wave Foam";
		TextureDesc.ShaderFileName = L"Ocean/Compute/WaveFoamSimulation.hlsl";
		TextureDesc.SamplerStateNames.clear();
		CS_SimulateFoam= new ComputeShader(TextureDesc);
	}
	{
		TextureDesc.ShaderName = "Normal Generator";
		TextureDesc.ShaderFileName = L"Ocean/Compute/NormalMapGenerator.hlsl";
		CS_NormalMapGenerator= new ComputeShader(TextureDesc);
	}
	{
		TextureDesc.ShaderName = "Self Texture Transpose";
		TextureDesc.ShaderFileName = L"Ocean/Compute/TransposeTextureSelf.hlsl";
		TextureDesc.DispatchZ = CascadeSize;
		CS_TransposeTexSelf = new ComputeShader(TextureDesc);
	}
	{
		TextureDesc.ShaderName = "Transpose Texture";
		TextureDesc.ShaderFileName = L"Ocean/Compute/TransposeTextureArray.hlsl";
		TextureDesc.DispatchZ = 3 * CascadeSize;
		TextureDesc.SamplerStateNames.clear();
		CS_TransposeTexArray = new ComputeShader(TextureDesc);
	}
	// IFFT
	{
		FFTDesc.ShaderName = "2D IFFT RowPass";
		FFTDesc.ShaderFileName = L"Ocean/Compute/WaveIFFT_RowPass.hlsl";
		FFTDesc.DispatchZ = 3 * CascadeSize;
		CS_RowPassIFFT = new ComputeShader(FFTDesc);
	}
	{
		FFTDesc.ShaderName = "2D IFFT ColPass";
		FFTDesc.ShaderFileName = L"Ocean/Compute/WaveIFFT_ColPass.hlsl";
		FFTDesc.DispatchZ = 1 * CascadeSize;
		CS_ColPassIFFT = new ComputeShader(FFTDesc);
	}
}

void OceanScape::CreateInitialSpectrum()
{
	// World 기준 Wind가 info.FFTData.Wind로 들어온다.
	// FFT하는 Texture는 좌상단이 0,0이기에 Y축을 반전시켜준다.
	PhillipsInitData.Wind = PhillipsInitData.Wind = {Info.FFTData.Wind.X, -Info.FFTData.Wind.Y};
	CB_PhillipsInit->UpdateData(&PhillipsInitData, sizeof(PhillipsInitData));
	CS_SpectrumInitializer->BindCB(CB_PhillipsInit, 0);
	CS_SpectrumInitializer->BindSRV(GaussianRandomTexture2D->GetSRV(), 0);
	CS_SpectrumInitializer->BindUAV(InitialSpectrumTexture2D->GetUAV(), 0);
	CS_SpectrumInitializer->Dispatch();

	InitialSpectrumTexture2D->SaveOutputAsFile(L"Debug/HInits");
}

void OceanScape::SetupCSResources()
{
	SetInitialSpectrumResources();
	SetSpectrumUpdateResources();
	SetTransposeResources();
	SetFoamResources();

	CreateInitialSpectrum();
}

void OceanScape::SetupCells(const OceanScapeDesc & InDesc)
{
	OceanMaterial::MaterialDesc MatDesc;
	MatDesc.DisplacementMapTiling = InDesc.Dimension.X / static_cast<float>(InDesc.CellSize) * 2.f;
	MatDesc.DisplacementMapSize = InDesc.FFTData.Size;
	MatDesc.NoiseTiling = 1.f; // TODO
	MatDesc.Name = "Ocean Material";
	MatDesc.ShaderName = "Ocean";
	this->Mat = new OceanMaterial(MatDesc);
	OceanCell::SceneryCellDesc CellDesc {
		"Ocean Cell",
		Mat,
		InDesc.CellSize,
		InDesc.Dimension,
		static_cast<float>(InDesc.GridSize),
		this->Tf,
	};
	CellInstance = new OceanCell(CellDesc);
}

void OceanScape::SetInitialSpectrumResources()
{
	GaussianRandomTexture2D = Noise::CreateGaussian2DNoise(Info.FFTData.Size);
	InitialSpectrumTexture2D = new RWTexture2DArray(
		CascadeSize, Info.FFTData.Size, Info.FFTData.Size,
		DXGI_FORMAT_R32G32B32A32_FLOAT
	);

	PhillipsInitData.Width = static_cast<float>(Info.FFTData.Size);
	PhillipsInitData.Height = static_cast<float>(Info.FFTData.Size);
	// World 기준 Wind가 info.FFTData.Wind로 들어온다.
	// FFT하는 Texture는 좌상단이 0,0이기에 Y축을 반전시켜준다.
	PhillipsInitData.Wind = {Info.FFTData.Wind.X, -Info.FFTData.Wind.Y};
	PhillipsInitData.CascadeData[0] = {600, {0.f, 1.f}};	//Big Wave
	PhillipsInitData.CascadeData[1] = {256, {1.f, 2.f}};	//Medium Wave
	PhillipsInitData.CascadeData[2] = {50,  {2.f, FLT_MAX}}; //Small Wave

	CB_PhillipsInit = new ConstantBuffer(
		ShaderType::ComputeShader,
		0,
		&PhillipsInitData,
		"PhillipsSpectrum Init",
		sizeof(PhillipsInitDesc),
		false
	);
}

void OceanScape::SetSpectrumUpdateResources()
{
	SpectrumTexture2D = new RWTexture2DArray(
		CascadeSize * (UINT)SpectrumTextureType::MAX, Info.FFTData.Size, Info.FFTData.Size,
		DXGI_FORMAT_R32G32_FLOAT
	);
	IFFT_Result = new RWTexture2DArray(
		CascadeSize * (UINT)SpectrumTextureType::MAX, Info.FFTData.Size, Info.FFTData.Size,
		DXGI_FORMAT_R32G32_FLOAT
	);
	
	PhilipsUpdateData.Width = static_cast<float>(Info.FFTData.Size);
	PhilipsUpdateData.Height = static_cast<float>(Info.FFTData.Size);
	PhilipsUpdateData.RunningTime = 0.f;
	PhilipsUpdateData.InitTime = sdt::SystemTimer::Get()->GetRunningTime();
	CB_PhillipsUpdate = new ConstantBuffer(
		ShaderType::ComputeShader,
		0,
		&PhilipsUpdateData,
		"PhillipsSpectrum Update",
		sizeof(PhilipsUpdateDesc),
		false
	);
}

void OceanScape::SetTransposeResources()
{
	IFFT_Result_Transposed = new RWTexture2DArray(
		CascadeSize * (UINT)SpectrumTextureType::MAX, Info.FFTData.Size, Info.FFTData.Size,
		DXGI_FORMAT_R32G32_FLOAT
	);
	
	TransposeData.Width  = static_cast<float>(Info.FFTData.Size);
	TransposeData.Height = static_cast<float>(Info.FFTData.Size);
	CB_Transpose = new ConstantBuffer(
		ShaderType::ComputeShader,
		0,
		&TransposeData,
		"IFFT Transpose",
		sizeof(TransposeData),
		false
	);
}

void OceanScape::SetFoamResources()
{
	FoamData.Width = static_cast<float>(Info.FFTData.Size);
	FoamData.Height = static_cast<float>(Info.FFTData.Size);
	FoamData.FoamThreshold = 1.f;
	FoamData.FoamMultiplier = 5.f;
	FoamData.FoamSharpness = 1.f;
	CB_Foam = new ConstantBuffer(
		ShaderType::ComputeShader,
		0,
		nullptr,
		"IFFT Transpose",
		sizeof(FoamDesc),
		false
	);
}

void OceanScape::UpdateSpectrum()
{
	const float OceanSimulateDeltaTime = sdt::SystemTimer::Get()->GetDeltaTime() * this->TimeScaler;  
	
	PhilipsUpdateData.RunningTime += OceanSimulateDeltaTime;
	CB_PhillipsUpdate->UpdateData(&PhilipsUpdateData, sizeof(PhilipsUpdateDesc));
	CS_SpectrumUpdater->BindCB(CB_PhillipsUpdate, 0);
	CS_SpectrumUpdater->BindSRV(InitialSpectrumTexture2D->GetSRV(), 0);
	CS_SpectrumUpdater->BindUAV(SpectrumTexture2D->GetUAV(), 0);
	CS_SpectrumUpdater->Dispatch();

}

void OceanScape::IFFT()
{
	// 	Row IFFT
	CS_RowPassIFFT->BindCB(CB_PhillipsInit, 0);
	CS_RowPassIFFT->BindSRV(SpectrumTexture2D->GetSRV(), 0);
	CS_RowPassIFFT->BindUAV(IFFT_Result->GetUAV(), 0);
	CS_RowPassIFFT->Dispatch(); // FFTSize, 1, 9
	// 	Transpose
	CS_TransposeTexArray->BindCB(CB_Transpose, 0);
	CS_TransposeTexArray->BindSRV(IFFT_Result->GetSRV(), 0);
	CS_TransposeTexArray->BindUAV(IFFT_Result_Transposed->GetUAV(), 0);
	CS_TransposeTexArray->Dispatch(); // TextureSize, TextureSize, 9
	// 	Col IFFT
	RWTexture2DArray * const DisplacementMaps = Mat->GetDisplacementMaps(); 
	CS_ColPassIFFT->BindCB(CB_PhillipsInit, 0);
	CS_ColPassIFFT->BindSRV(IFFT_Result_Transposed->GetSRV(), 0);
	CS_ColPassIFFT->BindUAV(DisplacementMaps->GetUAV(), 0);
	CS_ColPassIFFT->Dispatch(); // FFTSize, 1, 3

	// DisplacementMap 전치
	CS_TransposeTexSelf->BindCB(CB_Transpose, 0);
	CS_TransposeTexSelf->BindUAV(DisplacementMaps->GetUAV(), 0);
	CS_TransposeTexSelf->Dispatch();
}

