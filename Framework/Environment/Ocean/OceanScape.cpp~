void OceanScape::UpdateNormalMap()
{
	if (!!CS_NormalMapGenerator)
	{
		TransposeData.Width      = static_cast<float>(Info.FFTData.Size);
		TransposeData.Height     = static_cast<float>(Info.FFTData.Size);
		TransposeData.Padding1 = GetHeightScaler();                     //HeightScaler
		TransposeData.Padding2 = this->Mat->GetDisplacementMapTiling(); //Tiling
		CB_Transpose->UpdateData(&TransposeData, sizeof(TransposeDesc));
		CS_NormalMapGenerator->BindCB(CB_Transpose, 0);
		CS_NormalMapGenerator->BindSRV(Mat->GetDisplacementMaps()->GetSRV(), 0);
		CS_NormalMapGenerator->BindSRV(Mat->GetFoamGridMaps()->GetSRV(), 1);
		CS_NormalMapGenerator->BindUAV(Mat->GetNormalMaps()->GetUAV(), 0);
		CS_NormalMapGenerator->Dispatch();
	}
}

